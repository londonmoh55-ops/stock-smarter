rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'londonmoh55@gmail.com';
    }

    // Shared warehouse — all signed-in staff read/write; admin can too.
    match /shared/{orgId}/warehouse/{docId} {
      allow read, write: if signedIn();
    }

    // Per-user profile (for admin team list).
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    match /users/{userId}/meta/{docId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // Legacy per-user warehouse (read-only migrate / cleanup).
    match /users/{userId}/warehouse/{docId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if signedIn() && (request.auth.uid == userId || isAdmin());
    }
  }
}
