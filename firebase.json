{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "apphosting": [
    {
      "backendId": "stockflow",
      "rootDir": "/",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        ".output",
        "dist-electron",
        ".cursor",
        "warehouse-backup-*.json",
        "bun.lock",
        "scripts/fetch-build-log.mjs",
        "scripts/build-meta.json"
      ]
    }
  ]
}
