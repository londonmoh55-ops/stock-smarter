rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'londonmoh55@gmail.com';
    }

    function isJsonBackup() {
      return request.resource != null
        && request.resource.contentType == 'application/json'
        && request.resource.size < 20 * 1024 * 1024;
    }

    // Signed-in staff (same trust as Firestore). Size cap only —
    // WhatsApp / phone files often send odd or empty contentType.
    match /warehouse/photos/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.size < 15 * 1024 * 1024;
      allow delete: if signedIn() && (isAdmin() || request.auth.uid == resource.metadata.uploadedBy);
    }

    match /warehouse/backups/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if signedIn() && isJsonBackup();
      allow delete: if isAdmin();
    }

    // Live warehouse state blob (replaces Firestore document `data`)
    match /warehouse/state/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if signedIn() && isJsonBackup();
      allow delete: if isAdmin();
    }
  }
}
