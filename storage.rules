rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'londonmoh55@gmail.com';
    }

    function isImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 15 * 1024 * 1024;
    }

    match /warehouse/photos/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if signedIn() && isImage();
      allow delete: if signedIn() && (isAdmin() || request.auth.uid == resource.metadata.uploadedBy);
    }
  }
}
